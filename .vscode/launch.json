{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "name": "Debug Homebridge",
        "program": "${workspaceFolder}/node_modules/.bin/homebridge",
        "preLaunchTask": "tsc: build - tsconfig.json",
        "internalConsoleOptions": "neverOpen",
        "args": ["-I", "-D"],
        "request": "launch",
        "skipFiles": [
          "<node_internals>/**"
        ],
      }
    ]
  }